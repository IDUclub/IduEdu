# Benchmark environments (recreate from requirements-bench.txt / environment-bench.yml)
.venv-bench/
.venv-pyrosm-conda/

# Downloaded OSM extracts — hundreds of MB, re-downloaded on demand
pbf_cache/
*.osm.pbf

# Raw Overpass responses the cityseer arm reads instead of refetching the city on
# every attempt. Gigabytes, and regenerated by the first warm-up that gets through.
cityseer_cache/

# Overpass / iduedu response caches: paper2026/.iduedu_cache for the study, and
# paper2026/timing_cache for the timing benchmarks, kept apart so a fresh timing run
# never reads responses fetched for the study. `cache/` catches the relative
# directory OSMnx creates in the working directory of a benchmark.
.iduedu_cache/
timing_cache/
cache/

# Downloaded GTFS archives, catalog snapshots, merged city feeds and built graphs —
# gigabytes, rebuilt on demand, published through Zenodo rather than Git
feed_cache/
catalog_cache/
city_feeds/
bench_feeds/
bench_feeds*.zip
osm_graphs/
gtfs_graphs/
osm_graphs_variants/
osm_graphs_robustness/
# Geofabrik extracts, regional and per city (a junction to D:/iduedu_osm_pbf here)
osm/

# Benchmark run logs
results/logs/

# Redundant CSV backups
results/*.backup.csv

# Research data and processed outputs are published through Zenodo, not Git
results/
buildings_spb.parquet
schools_spb.parquet

# Local MDPI submission assets and prepared Zenodo uploads
Definitions/
zenodo-staging/
template.tex

# Python
__pycache__/
*.py[cod]

# Jupyter
.ipynb_checkpoints/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.out
*.toc
*.log
*.synctex.gz
*.fdb_latexmk
*.fls
*.pdf

# Assembled by pipeline/deposit.py; rebuilt on demand, never committed.
# One per paper: deposit_cus/ now, deposit_ga/ when that study is deposited.
deposit*/
deposit*.zip
osm_graphs_robustness_*/
figures/for_journal/
figures/*.eps

# Manuscripts stay out of Git until their papers are published: a public repo is
# a preprint, and that is a decision to take deliberately rather than by commit.
# The text lives in manuscript_cus/paper_en_*.py, is built by build_submission.py
# and travels to the journal and to Zenodo, not to GitHub.
# (sample-base.bib was committed before this rule and stays tracked; a rule here
# would not remove it.) The tables and counts of paper B go with its manuscript.
manuscript_cus/
manuscript_ga/
figures/paper_b/

# Working notes, in Russian and for us: decisions, blockers, the running plan,
# and the literature search behind the review. Reviewer reports are confidential,
# and .idus/ holds the author's language-review settings.
PLAN.md
drafts/
archive/
reviews/
.idus/

# Scaffolding, not the study. These scripts answered questions that are now
# settled -- which journal to aim at, how long its articles run, whether a drop
# in a parse was real -- and their own README opens by saying nothing here is
# needed to reproduce a result. They also write into drafts/, which is not kept.
tools/
/references/
/inputs/
