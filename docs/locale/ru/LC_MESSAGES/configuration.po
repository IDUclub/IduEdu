msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~typing.Iterator\\`\\\\ \\\\\\[\\:py\\:class\\:\\`\\~iduedu.config.Config\\`\\]`"

msgid "Example"
msgstr "Пример"

msgid "Build the Overpass query header for JSON requests."
msgstr "Формирует заголовок запроса Overpass для ответов в JSON."

msgid "Optional timeout override in seconds. If omitted, the configured default timeout is used."
msgstr "Необязательный тайм-аут в секундах вместо настроенного. Если не указан, используется тайм-аут по умолчанию."

msgid "Optional Overpass snapshot date override in ISO UTC format. If omitted, ``self.overpass_date`` is used."
msgstr "Необязательная дата снимка Overpass в формате ISO UTC вместо настроенной. Если не указана, используется ``self.overpass_date``."

msgid ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`str\\``"
msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`str\\``"

msgid "Returns"
msgstr "Результат"

msgid "Header string such as ``[out:json][timeout:120];`` or ``[out:json][timeout:120][date:\"2020-01-01T00:00:00Z\"];``."
msgstr "Строка заголовка, например ``[out:json][timeout:120];`` или ``[out:json][timeout:120][date:\"2020-01-01T00:00:00Z\"];``."

msgid "If the effective timeout is not positive."
msgstr "Если итоговый тайм-аут не положителен."

msgid "Current default Overpass query header."
msgstr "Текущий заголовок запросов Overpass по умолчанию."

msgid "Enable or disable progress bars for long-running operations."
msgstr "Включает или отключает индикаторы прогресса для долгих операций."

msgid "Set OSM edge tags retained by drive graph builders."
msgstr "Задаёт теги OSM, сохраняемые на рёбрах автомобильных графов."

msgid "Set OSM edge tags retained by walk graph builders."
msgstr "Задаёт теги OSM, сохраняемые на рёбрах пешеходных графов."

msgid "Set OSM edge tags retained by public-transport graph builders."
msgstr "Задаёт теги OSM, сохраняемые на рёбрах графов общественного транспорта."

msgid "Configure Overpass request pacing and retry behavior."
msgstr "Настраивает темп запросов к Overpass и повторные попытки."

msgid "Minimum delay between Overpass requests in seconds."
msgstr "Минимальная пауза между запросами к Overpass в секундах."

msgid "Maximum number of retry attempts for retryable HTTP statuses."
msgstr "Максимальное число повторов для статусов HTTP, допускающих повтор."

msgid "Base multiplier for exponential retry backoff."
msgstr "Основание экспоненциальной задержки между повторами."

msgid "If any provided value is outside its accepted range."
msgstr "Если какое-либо значение вне допустимого диапазона."

msgid "Return a serializable snapshot of the current configuration."
msgstr "Возвращает сериализуемый снимок текущих настроек."

