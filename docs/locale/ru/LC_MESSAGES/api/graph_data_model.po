msgstr "https://iduclub.github.io/IduEdu/examples/graph_operations.html"

msgid "Keep only the largest graph component."
msgstr "Оставляет только наибольшую компоненту графа."

msgid "Search once for distances and/or routes. See :func:`iduedu.single_source_dijkstra`."
msgstr "Один поиск расстояний и/или маршрутов. См. :func:`iduedu.single_source_dijkstra`."

