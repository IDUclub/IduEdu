msgid "Return weakly connected components, ignoring edge direction."
msgstr "Возвращает компоненты слабой связности без учёта направления рёбер."

msgid "Return strongly connected components."
msgstr "Возвращает компоненты сильной связности."

msgid "Return the largest component according to the selected mode."
msgstr "Возвращает наибольшую компоненту в выбранном режиме."

