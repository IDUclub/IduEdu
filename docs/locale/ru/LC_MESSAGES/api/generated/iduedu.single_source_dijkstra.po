msgid "iduedu.single\\_source\\_dijkstra"
msgstr "iduedu.single\\_source\\_dijkstra"

msgid "Search from one node; return distances, paths, or both from one traversal."
msgstr "Поиск от одного узла; возвращает расстояния, пути или и то и другое за один обход."

msgid "Parameters"
msgstr "Параметры"

msgid "Urban graph to search."
msgstr "Городской граф для поиска."

msgid "Source graph node id."
msgstr "Идентификатор узла-источника в графе."

msgid "Requested target ids, or None for all reachable nodes. Explicit targets retain their order, including unreachable targets."
msgstr "Запрошенные идентификаторы целей или None для всех достижимых узлов. Явно заданные цели сохраняют свой порядок, включая недостижимые."

msgid "Non-negative edge cost; time_min uses minutes, length_meter meters."
msgstr "Неотрицательная стоимость рёбер; time_min — в минутах, length_meter — в метрах."

msgid "Inclusive maximum total cost. None means no limit."
msgstr "Максимальная общая стоимость включительно. None — без ограничения."

msgid "Search the reversed directed graph; routes are returned in the original graph direction, from a target towards the source."
msgstr "Искать по обращённому ориентированному графу; маршруты возвращаются в направлении исходного графа, от цели к источнику."

msgid "distances, paths, or both (a ShortestPathResult)."
msgstr "distances, paths или both (ShortestPathResult)."

msgid "eager creates paths immediately; lazy requires output=both and reconstructs routes through result.get_path(target)."
msgstr "eager сразу создаёт пути; lazy требует output=both и восстанавливает маршруты через result.get_path(target)."

msgid "Returned distance dtype. Kernel arithmetic remains float32."
msgstr "Тип возвращаемых расстояний. Арифметика ядра остаётся float32."

msgid "Return type"
msgstr "Тип результата"

msgid ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~pandas.Series\\` \\| \\:py\\:class\\:\\`\\~pandas.DataFrame\\` \\| \\:py\\:class\\:\\`\\~iduedu.graph.routing\\_result.ShortestPathResult\\``"
msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~pandas.Series\\` \\| \\:py\\:class\\:\\`\\~pandas.DataFrame\\` \\| \\:py\\:class\\:\\`\\~iduedu.graph.routing\\_result.ShortestPathResult\\``"

msgid "Returns"
msgstr "Результат"

msgid "A sparse Series indexed by target node ids, or ShortestPathResult with matching distance and path Series. Missing costs/paths are inf/None."
msgstr "Разреженная Series с индексом по идентификаторам целевых узлов или ShortestPathResult с согласованными Series расстояний и путей. Отсутствующие стоимости и пути — inf/None."

