msgid "iduedu.largest\\_component"
msgstr "iduedu.largest\\_component"

msgid "Return the largest component according to the selected connectivity mode."
msgstr "Возвращает наибольшую компоненту в выбранном режиме связности."

msgid "Parameters"
msgstr "Параметры"

msgid "Graph to inspect."
msgstr "Изучаемый граф."

msgid "Connectivity mode. ``\"auto\"`` selects ``\"strong\"`` for directed graphs and ``\"connected\"`` for undirected graphs."
msgstr "Режим связности. ``\"auto\"`` выбирает ``\"strong\"`` для ориентированных графов и ``\"connected\"`` для неориентированных."

msgid "Return type"
msgstr "Тип результата"

msgid ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`set\\`\\\\ \\\\\\[\\:py\\:data\\:\\`\\~typing.Any\\`\\]`"
msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`set\\`\\\\ \\\\\\[\\:py\\:data\\:\\`\\~typing.Any\\`\\]`"

msgid "Returns"
msgstr "Результат"

msgid "Set of node ids in the largest component. Returns an empty set for an empty graph."
msgstr "Множество идентификаторов узлов наибольшей компоненты. Для пустого графа — пустое множество."

msgid "Raises"
msgstr "Исключения"

msgid "If ``mode`` is not supported."
msgstr "Если ``mode`` не поддерживается."

msgid "https://iduclub.github.io/IduEdu/examples/connectivity.html"
msgstr "https://iduclub.github.io/IduEdu/examples/connectivity.html"

