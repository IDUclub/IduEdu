msgid "iduedu.write\\_gml"
msgstr "iduedu.write\\_gml"

msgid "Write a NetworkX graph to GML, coercing node coordinates to plain floats."
msgstr "Записывает граф NetworkX в GML, приводя координаты узлов к обычным числам с плавающей точкой."

msgid "Ensures node attributes `x` and `y` are Python `float`, then writes the graph using `stringizer=str` so any non-primitive attribute values are serialized as strings."
msgstr "Приводит атрибуты узлов `x` и `y` к `float` Python и записывает граф с `stringizer=str`, чтобы любые непримитивные значения атрибутов сериализовались строками."

msgid "Parameters"
msgstr "Параметры"

msgid "Input graph. Not mutated - a sanitized copy is written."
msgstr "Входной граф. Не изменяется — записывается очищенная копия."

msgid "Output GML file path."
msgstr "Путь к выходному файлу GML."

msgid "Returns"
msgstr "Результат"

msgid "The sanitized copy of the graph that was written to disk."
msgstr "Очищенная копия графа, записанная на диск."

msgid "Return type"
msgstr "Тип результата"

