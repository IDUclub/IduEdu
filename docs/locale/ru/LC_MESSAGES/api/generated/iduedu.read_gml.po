msgid "iduedu.read\\_gml"
msgstr "iduedu.read\\_gml"

msgid "Read a GML file into a NetworkX graph and cast edge `geometry` from WKT strings to shapely."
msgstr "Читает файл GML в граф NetworkX и преобразует `geometry` рёбер из строк WKT в объекты shapely."

msgid "Loads the graph via `networkx.read_gml` and, when an edge attribute `geometry` is a string, attempts to parse it with `shapely.wkt.from_wkt`. Non-parsable strings are left unchanged."
msgstr "Загружает граф через `networkx.read_gml` и, если атрибут ребра `geometry` — строка, пытается разобрать его с помощью `shapely.wkt.from_wkt`. Неразбираемые строки остаются без изменений."

msgid "Parameters"
msgstr "Параметры"

msgid "Path to the GML file."
msgstr "Путь к файлу GML."

msgid "Additional keyword arguments forwarded to `networkx.read_gml`."
msgstr "Дополнительные именованные аргументы для `networkx.read_gml`."

msgid "Returns"
msgstr "Результат"

msgid "The graph with edge `geometry` parsed to shapely objects where possible."
msgstr "Граф, в котором `geometry` рёбер по возможности преобразована в объекты shapely."

msgid "Return type"
msgstr "Тип результата"

