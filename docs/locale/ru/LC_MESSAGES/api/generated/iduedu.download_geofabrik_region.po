msgid "iduedu.download\\_geofabrik\\_region"
msgstr "iduedu.download\\_geofabrik\\_region"

msgid "Download the Geofabrik extract ``region`` (an id from :func:`geofabrik_regions`)."
msgstr "Скачивает выгрузку Geofabrik ``region`` (идентификатор из :func:`geofabrik_regions`)."

msgid "Parameters"
msgstr "Параметры"

msgid "Geofabrik region id, e.g. ``\"northwestern-fed-district\"``."
msgstr "Идентификатор региона Geofabrik, например ``\"northwestern-fed-district\"``."

msgid "Cache directory; defaults to ``<config.overpass_cache_dir>/geofabrik``."
msgstr "Папка кеша; по умолчанию ``<config.overpass_cache_dir>/geofabrik``."

msgid "Re-download when Geofabrik has a newer file (compared by md5). Without it an existing file is reused as is, which keeps results reproducible."
msgstr "Скачать заново, если у Geofabrik есть более новый файл (сравнение по md5). Без этого существующий файл используется как есть, что сохраняет воспроизводимость результатов."

msgid "Return type"
msgstr "Тип результата"

msgid ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~pathlib.Path\\``"
msgstr ":sphinx_autodoc_typehints_type:`\\:py\\:class\\:\\`\\~pathlib.Path\\``"

msgid "Returns"
msgstr "Результат"

msgid "Path of the ``<region>-latest.osm.pbf`` file."
msgstr "Путь к файлу ``<region>-latest.osm.pbf``."

