msgid "iduedu.keep\\_largest\\_connected\\_component"
msgstr "iduedu.keep\\_largest\\_connected\\_component"

msgid "Keep only the largest component of an ``UrbanGraph``."
msgstr "Оставляет только наибольшую компоненту ``UrbanGraph``."

msgid "With ``mode=\"auto\"``, directed graphs use the largest strongly connected component and undirected graphs use the largest connected component."
msgstr "При ``mode=\"auto\"`` для ориентированных графов берётся наибольшая компонента сильной связности, для неориентированных — наибольшая компонента связности."

