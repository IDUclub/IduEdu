msgid "Connectivity diagnostics"
msgstr "Диагностика связности"

msgid "Connectivity helpers inspect components and help remove disconnected fragments before routing."
msgstr "Функции связности изучают компоненты и помогают удалить несвязные фрагменты перед маршрутизацией."

msgid "Undirected connected components"
msgstr "Компоненты связности неориентированного графа"

msgid "Use `connected_components` for undirected graphs such as walking networks."
msgstr "Используйте `connected_components` для неориентированных графов, таких как пешеходные сети."

msgid "Directed graph connectivity"
msgstr "Связность ориентированного графа"

msgid "For directed graphs, weak components ignore edge direction and strong components require reachability in both directions."
msgstr "В ориентированных графах слабые компоненты не учитывают направление рёбер, а сильные требуют достижимости в обе стороны."

msgid "Keep the largest component"
msgstr "Наибольшая компонента"

msgid "Builders can do this automatically with `keep_largest_subgraph=True`. The same operation is available as a method."
msgstr "Функции построения могут делать это автоматически с `keep_largest_subgraph=True`. Та же операция доступна как метод."

